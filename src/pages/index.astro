    window.addEventListener('scroll', () => {
      const h = document.documentElement;
      const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      progressBar.style.width = (isFinite(pct) ? pct : 0) + '%';
    });

    renderHome();
  </script>
</body>
</html>
