    function renderSearch(q = '') {
      const term = q.trim().toLowerCase();
      const filtered = term
        ? ARTICLES.filter(a =>
            a.title.toLowerCase().includes(term) ||
            a.subtitle.toLowerCase().includes(term) ||
            a.author.toLowerCase().includes(term) ||
            a.category.toLowerCase().includes(term) ||
            a.paragraphs.join(' ').toLowerCase().includes(term)
          )
        : ARTICLES;

      searchResults.innerHTML = filtered.length
        ? filtered.map(a => `
            <div class="row" style="grid-template-columns:120px 1fr;" onclick="modal.classList.remove('open');openArticle('${a.id}')">
              <span class="cat">${a.category}</span>
              <div>
