---
// VERBUM MUNDI — Edição Digital Oficial
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>VERBUM MUNDI — Pensamento, teologia, fé e cultura.</title>
  <meta name="description" content="Revista digital independente dedicada à reflexão intelectual, formação teológica e diálogo com a cultura." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@200;300;400;500;700;900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --bk: #0A0A0A;
      --gr: #1C1C1C;
      --or: #C65D32;
      --sv: #A6A6A6;
      --iv: #F2EFE9;
      --sans: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
      --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { background: var(--bk); scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg);
      font-family: var(--serif);
      font-size: 18px;
      line-height: 1.65;
      transition: background-color 0.35s ease, color 0.35s ease;
    }
    body[data-theme="noir"] {
      --bg: var(--bk);
      --fg: var(--iv);
      --mu: var(--sv);
      --ln: #262626;
      --card: var(--gr);
    }
    body[data-theme="paper"] {
      --bg: var(--iv);
      --fg: #161614;
      --mu: #5E5B53;
      --ln: #D5D0C5;
      --card: #E7E3DA;
    }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; }
    .w { max-width: 1220px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
    .cat {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--or);
    }
    .meta {
      font-family: var(--sans);
      font-weight: 400;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      color: var(--mu);
    }
    .rule { width: 56px; height: 2px; background: var(--or); border: 0; margin: 0 0 22px; }

    /* Barra de Progresso de Leitura */
    #progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: var(--or);
      z-index: 100;
      transition: width 0.1s linear;
    }

    /* Cabeçalho */
    header.top {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(10, 10, 10, 0.96);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid #242424;
      color: var(--iv);
    }
    header.top .w {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 76px;
      gap: 20px;
    }
    nav.main {
      display: flex;
      gap: 24px;
      font-family: var(--sans);
      font-weight: 500;
      font-size: 0.76rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    nav.main button {
      background: none;
      border: 0;
      border-bottom: 1px solid transparent;
      color: var(--sv);
      padding: 6px 0;
      cursor: pointer;
      letter-spacing: inherit;
      text-transform: inherit;
      font-size: inherit;
      font-weight: inherit;
      transition: color 0.2s, border-color 0.2s;
    }
    nav.main button:hover, nav.main button.active {
      color: var(--iv);
      border-bottom-color: var(--or);
    }
    .tools { display: flex; gap: 14px; align-items: center; }
    .btn-ghost {
      background: none;
      border: 1px solid #333;
      color: var(--iv);
      font-family: var(--sans);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 7px 14px;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }
    .btn-ghost:hover { border-color: var(--or); color: var(--or); }
    #menu-btn { display: none; }

    @media (max-width: 960px) {
      #menu-btn { display: inline-block; }
      nav.main {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        right: 0;
        background: var(--bk);
        flex-direction: column;
        gap: 0;
        padding: 12px clamp(20px, 4vw, 48px) 24px;
        border-bottom: 1px solid #262626;
      }
      nav.main.open { display: flex; }
      nav.main button {
        text-align: left;
        padding: 14px 0;
        border-bottom: 1px solid #1E1E1E;
        font-size: 0.88rem;
      }
    }

    /* Capa Assimétrica (Texto à esquerda, Arte Cinematográfica à direita) */
    .hero {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(32px, 5vw, 72px);
      padding: clamp(44px, 7vh, 84px) 0;
      border-bottom: 1px solid var(--ln);
      align-items: center;
    }
    .hero h1 {
      font-weight: 400;
      font-size: clamp(2.3rem, 4.6vw, 4.1rem);
      line-height: 1.06;
      letter-spacing: -0.02em;
      margin: 14px 0 20px;
      cursor: pointer;
      transition: color 0.2s;
    }
    .hero h1:hover { color: var(--or); }
    .hero p.lead {
      font-size: 1.22rem;
      color: var(--mu);
      line-height: 1.55;
      margin: 0 0 24px;
      max-width: 34em;
    }
    .btn-primary {
      display: inline-block;
      background: var(--or);
      color: #0A0A0A;
      border: 0;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 14px 26px;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .btn-primary:hover { opacity: 0.9; }

    .hero-art {
      position: relative;
      background: var(--gr);
      border: 1px solid #2A2A2A;
      overflow: hidden;
      cursor: pointer;
    }
    .hero-art img {
      display: block;
      width: 100%;
      height: 500px;
      object-fit: cover;
      filter: contrast(1.08) brightness(0.86);
      transition: transform 0.7s ease;
    }
    .hero-art:hover img { transform: scale(1.025); }
    .hero-art::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0.15) 55%, transparent 100%);
      pointer-events: none;
    }
    .hero-caption {
      position: absolute;
      bottom: 20px;
      left: 22px;
      right: 22px;
      z-index: 2;
      border-left: 2px solid var(--or);
      padding-left: 14px;
    }
    .hero-caption span {
      display: block;
      font-family: var(--sans);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--or);
      margin-bottom: 4px;
    }
    .hero-caption p {
      margin: 0;
      font-size: 0.92rem;
      color: var(--iv);
      font-style: italic;
    }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; }
      .hero-art img { height: 340px; }
    }

    /* Manifesto Strip */
    .manifesto-box {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 32px;
      padding: 48px 0;
      border-bottom: 1px solid var(--ln);
      align-items: start;
    }
    .manifesto-box blockquote {
      margin: 0;
      font-size: clamp(1.3rem, 2.2vw, 1.75rem);
      line-height: 1.45;
      color: var(--iv);
    }
    @media (max-width: 760px) {
      .manifesto-box { grid-template-columns: 1fr; gap: 14px; }
    }

    /* Seções Editoriais */
    .sec { padding: clamp(44px, 7vh, 76px) 0; border-bottom: 1px solid var(--ln); }
    .sec-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 28px;
    }
    .sec-head h2 {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--mu);
      margin: 0;
    }

    /* Linhas Editoriais */
    .row {
      display: grid;
      grid-template-columns: 160px 1fr 180px;
      gap: 24px;
      padding: 24px 0;
      border-top: 1px solid var(--ln);
      align-items: baseline;
      cursor: pointer;
    }
    .row:hover h3 { color: var(--or); }
    .row h3 {
      font-weight: 400;
      font-size: 1.65rem;
      line-height: 1.2;
      margin: 0 0 6px;
      transition: color 0.2s;
    }
    .row p { margin: 0; color: var(--mu); font-size: 1.02rem; }
    .row .right-meta { text-align: right; }
    @media (max-width: 780px) {
      .row { grid-template-columns: 1fr; gap: 8px; }
      .row .right-meta { text-align: left; }
    }

    /* Seleção Editorial 3 Colunas */
    .cols {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(24px, 3.5vw, 44px);
    }
    @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
    .card-ed {
      border-top: 2px solid var(--or);
      padding-top: 18px;
      cursor: pointer;
    }
    .card-ed img {
      width: 100%;
      height: 210px;
      object-fit: cover;
      margin-bottom: 16px;
      filter: contrast(1.06) brightness(0.9);
    }
    .card-ed h3 {
      font-weight: 400;
      font-size: 1.42rem;
      line-height: 1.25;
      margin: 8px 0 10px;
      transition: color 0.2s;
    }
    .card-ed:hover h3 { color: var(--or); }
    .card-ed p { margin: 0 0 12px; color: var(--mu); font-size: 0.98rem; }

    /* Índice de Categorias */
    .cat-list button {
      width: 100%;
      background: none;
      border: 0;
      border-top: 1px solid var(--ln);
      color: var(--fg);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 20px 0;
      font-family: var(--serif);
      font-size: clamp(1.55rem, 3.4vw, 2.4rem);
      cursor: pointer;
      text-align: left;
      transition: padding-left 0.25s, color 0.2s;
    }
    .cat-list button:hover { padding-left: 14px; color: var(--or); }
    .cat-list small {
      font-family: var(--sans);
      font-size: 0.8rem;
      color: var(--mu);
      max-width: 26em;
      text-align: right;
    }
    @media (max-width: 680px) { .cat-list small { display: none; } }

    /* Experiência de Leitura (Papel Marfim #F2EFE9) */
    .article-view {
      max-width: 680px;
      margin: 0 auto;
      padding: clamp(44px, 7vh, 84px) 20px 64px;
    }
    .back-btn {
      background: none;
      border: 0;
      color: var(--or);
      font-family: var(--sans);
      font-size: 0.76rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0;
      margin-bottom: 28px;
      cursor: pointer;
      display: inline-block;
    }
    .article-view h1 {
      font-weight: 500;
      font-size: clamp(2.1rem, 5vw, 3.35rem);
      line-height: 1.08;
      letter-spacing: -0.015em;
      margin: 12px 0 16px;
    }
    .article-view .subtitle {
      font-size: 1.3rem;
      font-style: italic;
      color: var(--mu);
      line-height: 1.45;
      margin: 0 0 24px;
    }
    .byline {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 20px;
      padding: 14px 0;
      border-top: 1px solid var(--ln);
      border-bottom: 1px solid var(--ln);
      margin-bottom: 34px;
    }
    .article-cover {
      margin: 0 0 38px;
    }
    .article-cover img {
      width: 100%;
      height: 360px;
      object-fit: cover;
      display: block;
      border-bottom: 3px solid var(--or);
    }
    .article-cover figcaption { margin-top: 8px; }

    .article-body {
      font-size: 1.2rem;
      line-height: 1.78;
      hyphens: auto;
    }
    .article-body p { margin: 0 0 1.2em; }
    .article-body > p:first-of-type::first-letter {
      float: left;
      font-size: 4.1em;
      line-height: 0.8;
      padding: 0.06em 0.12em 0 0;
      font-weight: 500;
      color: var(--or);
    }
    .article-body h2 {
      font-size: 1.6rem;
      font-weight: 500;
      line-height: 1.25;
      margin: 2.1em 0 0.65em;
    }
    .article-body blockquote.pull {
      margin: 2.2em 0;
      padding: 4px 0 4px 1.4em;
      border-left: 2px solid var(--or);
      font-size: 1.42rem;
      font-style: italic;
      line-height: 1.45;
    }
    .article-body sup a {
      color: var(--or);
      font-family: var(--sans);
      font-weight: 600;
      font-size: 0.72rem;
      padding: 0 2px;
    }

    .footnotes, .references {
      margin-top: 2.6em;
      padding-top: 1.2em;
      border-top: 1px solid var(--ln);
      font-size: 0.94rem;
      line-height: 1.6;
      color: var(--mu);
    }
    .footnotes h3, .references h3 {
      font-family: var(--sans);
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg);
      margin: 0 0 12px;
    }
    .references p {
      padding-left: 1.6em;
      text-indent: -1.6em;
      margin: 0 0 0.7em;
    }
    .share-bar {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid var(--ln);
    }
    .share-btn {
      background: none;
      border: 0;
      border-bottom: 1px solid var(--or);
      color: var(--or);
      font-family: var(--sans);
      font-size: 0.8rem;
      font-weight: 500;
      padding: 2px 0;
      cursor: pointer;
    }

    /* Modal de Busca */
    .search-modal {
      position: fixed;
      inset: 0;
      background: rgba(10, 10, 10, 0.96);
      z-index: 90;
      display: none;
      padding: 64px 20px;
      overflow-y: auto;
    }
    .search-modal.open { display: block; }
    .search-inner { max-width: 760px; margin: 0 auto; color: var(--iv); }
    .search-input {
      width: 100%;
      background: none;
      border: 0;
      border-bottom: 1px solid var(--or);
      color: var(--iv);
      font-family: var(--serif);
      font-size: 1.6rem;
      padding: 14px 0;
      outline: none;
      margin-bottom: 28px;
    }

    /* Formulário */
    .form-box { display: grid; gap: 16px; max-width: 560px; margin-top: 24px; }
    .form-box input, .form-box textarea {
      background: none;
      border: 0;
      border-bottom: 1px solid var(--mu);
      color: var(--fg);
      font-family: var(--serif);
      font-size: 1.1rem;
      padding: 10px 0;
      width: 100%;
    }

    /* Rodapé */
    footer.bottom {
      background: var(--bk);
      color: var(--iv);
      border-top: 1px solid #242424;
      padding: 60px 0 36px;
      font-family: var(--sans);
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 40px;
    }
    @media (max-width: 800px) { .footer-grid { grid-template-columns: 1fr; } }
    footer h4 {
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--iv);
      margin: 0 0 14px;
    }
    footer ul { list-style: none; padding: 0; margin: 0; }
    footer li { margin-bottom: 8px; }
    footer li button, footer li a {
      background: none;
      border: 0;
      padding: 0;
      color: var(--sv);
      font-size: 0.86rem;
      cursor: pointer;
    }
    footer li button:hover, footer li a:hover { color: var(--or); }
    .nl-form { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
    .nl-form input {
      flex: 1;
      min-width: 200px;
      background: none;
      border: 0;
      border-bottom: 1px solid #555;
      color: var(--iv);
      font-family: var(--serif);
      font-size: 1.05rem;
      padding: 8px 0;
    }
    .copyright {
      border-top: 1px solid #222;
      margin-top: 40px;
      padding-top: 20px;
      font-size: 0.76rem;
      color: var(--sv);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .hidden { display: none !important; }
  </style>
</head>
<body data-theme="noir">
  <div id="progress-bar"></div>

  <header class="top">
    <div class="w">
      <a href="#" id="brand-home" aria-label="VERBUM MUNDI — Inicio">
        <!-- Logotipo Oficial Variação 02 — Cinematográfico -->
        <svg width="248" height="48" viewBox="0 0 360 70" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="VERBUM MUNDI">
          <path d="M 214 15 A 56 34 0 0 1 322 15" stroke="#C65D32" stroke-width="2.4" fill="none"/>
          <text x="0" y="42" fill="#F2EFE9" font-family="Archivo, Helvetica Neue, Arial, sans-serif" font-size="27">
            <tspan font-weight="900" letter-spacing="1.2">VERBUM</tspan>
            <tspan font-weight="200" letter-spacing="8.5"> MUNDI</tspan>
          </text>
          <text x="1" y="61" fill="#A6A6A6" font-family="Archivo, Helvetica Neue, Arial, sans-serif" font-weight="400" font-size="8.6" letter-spacing="3.4">
            PENSAMENTO, TEOLOGIA, FÉ E CULTURA.
          </text>
        </svg>
      </a>

      <nav class="main" id="nav-menu" aria-label="Navegação editorial">
        <button data-route="home" class="active">Inicio</button>
        <button data-route="ensaios">Ensaios</button>
        <button data-route="teologia">Teologia</button>
        <button data-route="filosofia">Filosofia</button>
        <button data-route="cultura">Cultura</button>
        <button data-route="academico">Acadêmico</button>
        <button data-route="sobre">Sobre</button>
        <button data-route="contato">Contato</button>
      </nav>

      <div class="tools">
        <button class="btn-ghost" id="open-search">Buscar</button>
        <button class="btn-ghost" id="menu-btn">Menu</button>
      </div>
    </div>
  </header>

  <main id="app"></main>

  <!-- Modal de Busca -->
  <div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="Buscar na revista">
    <div class="search-inner">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
        <span class="cat">Pesquisa no Acervo</span>
        <button class="btn-ghost" id="close-search">Fechar [ESC]</button>
      </div>
      <input type="search" id="search-input" class="search-input" placeholder="Digite tema, autor ou palavra-chave..." />
      <div id="search-results"></div>
    </div>
  </div>

  <footer class="bottom">
    <div class="w">
      <div class="footer-grid">
        <div>
          <svg width="248" height="48" viewBox="0 0 360 70" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="VERBUM MUNDI">
            <path d="M 214 15 A 56 34 0 0 1 322 15" stroke="#C65D32" stroke-width="2.4" fill="none"/>
            <text x="0" y="42" fill="#F2EFE9" font-family="Archivo, Helvetica Neue, Arial, sans-serif" font-size="27">
              <tspan font-weight="900" letter-spacing="1.2">VERBUM</tspan>
              <tspan font-weight="200" letter-spacing="8.5"> MUNDI</tspan>
            </text>
            <text x="1" y="61" fill="#A6A6A6" font-family="Archivo, Helvetica Neue, Arial, sans-serif" font-weight="400" font-size="8.6" letter-spacing="3.4">
              PENSAMENTO, TEOLOGIA, FÉ E CULTURA.
            </text>
          </svg>
          <p style="color:var(--sv);font-size:0.9rem;max-width:34ch;margin:14px 0 0;">
            Publicação editorial independente dedicada à reflexão, formação teológica e diálogo com a cultura.
          </p>
          <form class="nl-form" id="nl-form">
            <input type="email" required placeholder="Seu melhor e-mail" aria-label="E-mail para newsletter" />
            <button type="submit" class="btn-primary">Assinar</button>
          </form>
          <p id="nl-feedback" class="meta" style="color:var(--or);margin-top:8px;"></p>
        </div>

        <div>
          <h4>Editorias</h4>
          <ul>
            <li><button data-route="ensaios">Ensaios</button></li>
            <li><button data-route="teologia">Teologia</button></li>
            <li><button data-route="filosofia">Filosofia</button></li>
            <li><button data-route="cultura">Cultura</button></li>
            <li><button data-route="academico">Acadêmico</button></li>
          </ul>
        </div>

        <div>
          <h4>Institucional</h4>
          <ul>
            <li><button data-route="sobre">Manifesto & Sobre</button></li>
            <li><button data-route="contato">Fale com a Redação</button></li>
          </ul>
        </div>
      </div>

      <div class="copyright">
        <span>© 2026 VERBUM MUNDI. Todos os direitos reservados.</span>
        <span>Pensamento, teologia, fé e cultura.</span>
      </div>
    </div>
  </footer>

  <script>
    const ARTICLES = [
      {
        id: 'entre-a-liberdade-e-o-peso-do-irreversivel',
        title: 'Entre a Liberdade e o Peso do Irreversível',
        subtitle: 'A Parábola do Grande Inquisidor, a culpa moral e a redenção da história em Dostoievski',
        category: 'Ensaios',
