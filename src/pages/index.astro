    window.openArticle = function(id) {
      const a = ARTICLES.find(item => item.id === id);
      if (!a) return;
      setTheme('paper');
      updateActiveNav(a.categorySlug);

      const mid = Math.floor(a.paragraphs.length / 2);
      const bodyHtml = a.paragraphs.map((p, idx) => {
        const pull = (idx === mid && a.pullQuote)
          ? `<blockquote class="pull">“${a.pullQuote}”</blockquote>`
          : '';
        return `<p>${p}</p>${pull}`;
      }).join('');

      const fnHtml = a.footnotes && a.footnotes.length
        ? `<div class="footnotes">
            <h3>Notas</h3>
            ${a.footnotes.map((fn, i) => `<p id="fn-${i+1}">${i+1}. ${fn} <a href="#ref-${i+1}" style="color:var(--or);">↩</a></p>`).join('')}
          </div>`
        : '';

      const refHtml = a.references && a.references.length
        ? `<div class="references">
            <h3>Referências Bibliográficas</h3>
            ${a.references.map(r => `<p>${r}</p>`).join('')}
          </div>`
        : '';

      app.innerHTML = `
        <article class="article-view">
          <button class="back-btn" onclick="renderHome()">← Voltar para a Capa</button>
          <div><span class="cat">${a.category}</span></div>
          <h1>${a.title}</h1>
          <p class="subtitle">${a.subtitle}</p>
          <div class="byline meta">
            <span>Por <strong>${a.author}</strong></span>
            <span>${a.date}</span>
            <span>${a.readingTime} min de leitura</span>
          </div>
          <figure class="article-cover">
            <img src="${a.image}" alt="${a.title}" />
            <figcaption class="meta">${a.caption || 'VERBUM MUNDI'}</figcaption>
          </figure>
          <div class="article-body">
            ${bodyHtml}
            ${fnHtml}
            ${refHtml}
          </div>
          <div class="share-bar">
            <span class="meta">Compartilhar:</span>
            <button class="share-btn" onclick="navigator.clipboard?.writeText(window.location.href);this.textContent='Link copiado!'">Copiar link</button>
            <button class="share-btn" onclick="renderHome()">Ver mais textos</button>
          </div>
        </article>
      `;
    };

